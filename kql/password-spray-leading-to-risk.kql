// Many users failing from one IP, followed by an Identity Protection spray detection or a success.
let window = 1h;
let sprayIps =
    SigninLogs
    | where TimeGenerated > ago(24h)
    | where ResultType in ("50126", "50053", "50057")
    | summarize FailedUsers = dcount(UserPrincipalName), Attempts = count() by IPAddress, bin(TimeGenerated, window)
    | where FailedUsers >= 10;
sprayIps
| join kind=leftouter (
    SigninLogs
    | where TimeGenerated > ago(24h) and ResultType == 0
    | project SuccessTime = TimeGenerated, SuccessUser = UserPrincipalName, IPAddress
  ) on IPAddress
| where isempty(SuccessTime) or SuccessTime between (TimeGenerated .. (TimeGenerated + window))
| project TimeGenerated, IPAddress, FailedUsers, Attempts, SuccessUser, SuccessTime
| order by FailedUsers desc
